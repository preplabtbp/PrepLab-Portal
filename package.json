{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "vite build && esbuild server.ts src/db/migrate.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outdir=dist --out-extension:.js=.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:auth": "tsx test/auth-guard.test.ts",
    "test": "npm run test:auth",
    "deploy:staging": "npm run build && gcloud run deploy preplab-portal-staging --source . --region asia-southeast2",
    "deploy:main": "npm run build && gcloud run deploy preplab-portal --source . --region us-central1"
  },
