# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Konfigurasi Database PostgreSQL (Wajib diisi saat deploy ke Cloud Run sendiri)
SQL_HOST="host.database.anda"
SQL_USER="postgres"
SQL_PASSWORD="password_database_anda"
SQL_DB_NAME="nama_database"

# Untuk menjalankan migrasi schema via Drizzle:
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="password_database_anda"

# SMTP Configuration for Email Reset
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

# Konfigurasi Google Drive
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
